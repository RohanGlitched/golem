{
  "name": "golem-site",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest --run",
    "test:e2e": "playwright test -c tests/playwright.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen": "node ../scripts/kiro-stats.mjs && vite-node scripts/gen-lexicon.ts && node scripts/gen-candy.mjs",
    "og": "node scripts/og.mjs",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "candy": "*",
    "hover": "*",
    "golem-spec": "*",
    "stagger": "*"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.14.0",
    "chrome-launcher": "^1.2.3",
    "fast-check": "^3.22.0",
    "lighthouse": "^13.6.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-node": "^2.1.0",
    "vitest": "^2.1.0",
    "wawoff2": "^2.0.1"
  }
}
