{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "types": [
      "node"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/__tests__/**",
    "src/**/*.testkit.ts",
    "src/ui/e2e/**",
    "src/**/*.prop.test.ts",
    "src/**/*.property.test.ts"
  ]
}
