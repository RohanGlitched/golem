{
  "name": "golem-spec",
  "version": "0.1.2",
  "description": "Turn the EARS acceptance criteria of a Kiro spec into MuJoCo physics property tests: falsify, shrink, pin seeds, and gate the AI agent until every requirement holds.",
  "keywords": [
    "kiro",
    "ears",
    "requirements",
    "property-based-testing",
    "falsification",
    "mujoco",
    "robotics",
    "humanoid",
    "mcp",
    "signal-temporal-logic",
    "simulation",
    "testing"
  ],
  "homepage": "https://d23v187fnxad7l.cloudfront.net/kit/",
  "bugs": {
    "url": "https://github.com/RohanGlitched/golem/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RohanGlitched/golem.git",
    "directory": "skeleton"
  },
  "license": "Apache-2.0",
  "author": "Rohan Borade",
  "type": "module",
  "bin": {
    "golem": "dist/cli/main.js",
    "golem-spec": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "kiro-pack",
    "starter",
    "power",
    "crew-app",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./ui/worker": {
      "types": "./dist/ui/worker.d.ts",
      "default": "./dist/ui/worker.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests && npm run test:latency",
    "test:latency": "vitest run --config vitest.latency.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo": "node ui-demo/fetch-fonts.mjs && vite --config ui-demo/vite.config.ts",
    "demo:shots": "node ui-demo/fetch-fonts.mjs && node ui-demo/shots.mjs",
    "e2e": "playwright test -c ui-demo/playwright.config.ts",
    "e2e:perf": "playwright test -c ui-demo/playwright.config.ts --grep @perf",
    "pack:build": "vite-node scripts/build-pack.ts",
    "pack:sync": "vite-node scripts/sync-power.ts",
    "pack:check": "vite-node scripts/sync-power.ts -- --check",
    "crew:assets": "vite-node scripts/make-crew-assets.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@mujoco/mujoco": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.48.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.170.0",
    "fast-check": "^3.22.0",
    "jsdom": "^25.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "fast-check": "^3.22.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "three": ">=0.160.0"
  },
  "peerDependenciesMeta": {
    "fast-check": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  }
}
