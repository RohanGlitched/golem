{
  "name": "golem-spec",
  "version": "0.1.0",
  "description": "Turn EARS acceptance criteria into physics property tests.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": { "golem": "dist/cli/main.js" },
  "files": ["dist", "kiro-pack"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./ui": { "types": "./dist/ui/index.d.ts", "default": "./dist/ui/index.js" },
    "./node": { "types": "./dist/node.d.ts", "default": "./dist/node.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mujoco/mujoco": "^4.0.1",
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "fast-check": "^3.22.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "three": ">=0.160.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true },
    "three": { "optional": true }
  }
}